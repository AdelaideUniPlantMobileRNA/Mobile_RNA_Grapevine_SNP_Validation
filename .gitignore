# ===== NEVER commit large or regenerable data to git =====
# Raw and processed data
data/raw/
data/processed/
data/external/
*.bam
*.bai
*.cram
*.fq
*.fastq
*.fq.gz
*.fastq.gz
*.fa
*.fasta
*.fa.gz
*.vcf
*.vcf.gz
*.gtf
*.gff
*.gff3

# Results / figures (regenerable) — track code, not outputs
results/
figures/
logs/
*.pdf
*.png

# Environments / caches
.conda/
__pycache__/
.Rhistory
.RData
.Rproj.user/
.ipynb_checkpoints/
.snakemake/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# ===== DO commit: =====
# scripts/, workflow/, config/, docs/, metadata/, README.md, environment.yml
# Track large files, if needed, with Git LFS or record their md5 in metadata/ instead.
